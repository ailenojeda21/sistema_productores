# =========================================================
# Contexto de build de Docker: exclusiones
# =========================================================
# NOTA: database, config, app, resources, routes,
# composer.json y composer.lock NO se excluyen: el build y la
# aplicación en ejecución los necesitan. Los assets de Vite se
# compilan en la etapa `assets` del Dockerfile, no en la máquina
# que construye la imagen.

# Entorno y secretos: nunca dentro de la imagen
.env
.env.*
!.env.example

# Control de versiones y CI
.git
.github

# Dependencias: se resuelven dentro de la imagen
node_modules
vendor

# Assets compilados: los genera la etapa `assets` a partir de
# `resources/`. Excluirlos evita que la imagen use un build local.
public/build

# Contenido generado en ejecución. Se conserva solo el marcador de
# cada directorio para que storage y bootstrap/cache existan.
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore

# Archivos subidos por los usuarios: datos personales que no deben
# quedar dentro de la imagen. Se conserva solo el marcador .gitignore.
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore

# RUT de productores (disco `rut_files`, ver config/filesystems.php):
# son PDFs con datos personales, nunca dentro de la imagen.
storage/app/rut_files/*

*.log

# Bases SQLite locales: nunca dentro de la imagen
database/*.sqlite

# Tests
tests

# IDE / editores
.idea
.vscode

# Documentación: las imágenes no se sirven en runtime
docs/imagenes
